# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub API (for checking repos and creating new ones)
GITHUB_TOKEN=your_github_personal_access_token

# Google Workspace (Sheets & Gmail)
# Note: You will also need a credentials.json file downloaded from Google Cloud Console
GOOGLE_SHEETS_ID=your_target_spreadsheet_id
